# ImageNet-64 PIXEL space -- the cheap tier's high rung. 3x64x64 = 12288 dims.
#
# This is the rung that makes the ladder credible, and it is NOT optional
# (FINDINGS.md 6): without it the trained evidence stops at 3072 dims while the
# measured evidence reaches 16384, a 5x gap. 12288 dims is THREE TIMES the
# dimension of a 256px SD-VAE latent -- "low resolution" and "low dimension" are
# not the same thing.
#
# Teacher: NVlabs EDM `edm-imagenet-64x64-cond-adm.pkl` (~296M, class-conditional).
# The pickle references `training.networks.*`, so the EDM source tree must be
# importable:
#
#   git clone https://github.com/NVlabs/edm /root/autodl-tmp/edm
#   export EDM_REPO=/root/autodl-tmp/edm
#   wget https://nvlabs-fi-cdn.nvidia.com/edm/pretrained/edm-imagenet-64x64-cond-adm.pkl \
#        -O $DD_CKPT_ROOT/edm-imagenet-64x64-cond-adm.pkl
#
# EDM checkpoints are ALREADY preconditioned denoisers D(x,sigma), so they are
# wrapped by `teachers.EDMPklDenoiser` (a passthrough) and NOT by EDMWrapper --
# double-preconditioning produces plausible output rather than an error.

DATASET_NAME="imagenet64"
RESOLUTION=64
LATENT_SIZE=64
NUM_CLASSES=1000

DATA_DIR="${DD_DATA_ROOT:-$REPO_ROOT/data}/in64"
CKPT_DIR="${DD_CKPT_ROOT:-$REPO_ROOT/ckpt}"

TEACHER_SPEC="edm:$CKPT_DIR/edm-imagenet-64x64-cond-adm.pkl"
TEACHER_NAME=""
TEACHER_CKPT="$CKPT_DIR/edm-imagenet-64x64-cond-adm.pkl"

DEFAULT_MICRO_BATCH=64
DEFAULT_STEPS=20000
DEFAULT_GPUS="0,1,2,3"
DEFAULT_N_STUDENT_STEPS=1
DEFAULT_CFG_SCALE=1.0
# EDM checkpoints carry no discrete schedule -- sigma is already the free
# variable -- so the matched training distribution is EDM's own lognormal.
DEFAULT_SIGMA_DIST="lognormal"
DEFAULT_MIN_REAL_BATCH=256

REF_N=50000
REF_NPZ="$DATA_DIR/ref_${RESOLUTION}_${REF_N}.npz"

prepare_dataset() {
  local src="${IMAGENET_SRC:-$REPO_ROOT/data/imagenet/ILSVRC/Data/CLS-LOC/train}"
  [[ -d "$src" ]] || {
    echo "[$DATASET_NAME] source not found at $src" >&2
    echo "[$DATASET_NAME] set IMAGENET_SRC to your ILSVRC train dir and re-run" >&2
    return 1
  }
  # ~15.7 GB of uint8 at 64px, versus 21 GB of latents at 256px and 84 GB at
  # 512px -- and no VAE anywhere in the pipeline.
  python3 -m ddgpu.prepare pixels \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" \
    --batch-size "${ENCODE_BATCH_SIZE:-256}" --num-workers "${ENCODE_NUM_WORKERS:-8}"
  python3 -m ddgpu.prepare refstats \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" --n "$REF_N" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-128}" \
    --num-workers "${ENCODE_NUM_WORKERS:-8}"
}
