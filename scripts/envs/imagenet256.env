# ImageNet-256 environment: DiT-XL/2 teacher, 4x32x32 latents (4096 dims).
#
# This is the LOW rung of the dimension ladder (FINDINGS.md 4, Run 2/3). Paired
# with imagenet512.env it varies latent dimension 4096 -> 16384 at *fixed*
# architecture, parameters and data -- the controlled ablation info.txt asks
# for, and the one a model swap (SD1.5 -> SDXL) cannot give you.
#
# Requires ImageNet (ILSVRC2012 train) locally. Point IMAGENET_SRC at the
# class-folder train dir, e.g. .../ILSVRC/Data/CLS-LOC/train (1000 subdirs).

DATASET_NAME="imagenet256"
RESOLUTION=256
LATENT_SIZE=32
NUM_CLASSES=1000

DATA_DIR="${DD_DATA_ROOT:-$REPO_ROOT/data}/in256"
CKPT_DIR="${DD_CKPT_ROOT:-$REPO_ROOT/ckpt}"

# DiT-XL/2 is the ONLY publicly released latent DiT (FINDINGS.md 4.0.1). Running
# the ladder on XL@256 vs XL@512 is cheaper than pretraining a DiT-B/2 teacher
# and is a cleaner ladder besides: identical architecture and data on both rungs.
TEACHER_NAME="DiT-XL-2-256x256"
TEACHER_CKPT="$CKPT_DIR/${TEACHER_NAME}.pt"

DEFAULT_MICRO_BATCH=32
DEFAULT_STEPS=50000
DEFAULT_GPUS="0,1,2,3,4,5,6,7"
DEFAULT_N_STUDENT_STEPS=1
DEFAULT_CFG_SCALE=1.75

# FID / precision-recall reference set.
REF_N=50000
REF_NPZ="$DATA_DIR/ref_${RESOLUTION}_${REF_N}.npz"

prepare_dataset() {
  local src="${IMAGENET_SRC:-$REPO_ROOT/data/imagenet/ILSVRC/Data/CLS-LOC/train}"
  [[ -d "$src" ]] || {
    echo "[$DATASET_NAME] source not found at $src" >&2
    echo "[$DATASET_NAME] set IMAGENET_SRC to your ILSVRC train dir and re-run" >&2
    return 1
  }
  python3 -m ddgpu.prepare latents \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-64}" \
    --num-workers "${ENCODE_NUM_WORKERS:-8}"
  python3 -m ddgpu.prepare refstats \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" --n "$REF_N" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-64}" \
    --num-workers "${ENCODE_NUM_WORKERS:-8}"
}
