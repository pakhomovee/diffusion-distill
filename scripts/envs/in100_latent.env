# ImageNet-100 @256px in SD-VAE LATENT space, with a SELF-TRAINED SiT-B/2 teacher.
#
# This is the leg that answers the reviewer question the rest of the cheap tier
# cannot: "does any of this hold in latent space?" Everything else in the cheap
# tier is pixel-space; this one is 4x32x32 = 4096 latent dims, the same working
# dimension as DiT-XL/2 on ImageNet-256, for ~1/5 the parameters and none of the
# teacher cost -- because the teacher already exists.
#
# Teacher: a SiT-B/2 (~130M) trained in the repa-surgery project, 300k steps,
# FID ~16 at 250k. Two properties make it scientifically useful rather than just
# convenient:
#
#   * LATENT space, closing the gap above.
#   * DELIBERATELY WEAKER than the released EDM/DiT teachers. FINDINGS.md 4's
#     Run 3 wanted a teacher-capacity axis: lambda is driven by the teacher's
#     bias profile, so a weaker teacher should push lambda DOWN (more bias for
#     the real-data term to correct). Comparing this leg's lambda curve against
#     CIFAR/ImageNet-64 gives that axis for free.
#
# SiT is a third preconditioning family: it predicts a VELOCITY along a linear
# stochastic interpolant, not eps and not x0. `ddgpu/interpolant.py` does the
# change of variables; the sigma <-> t map (t = sigma/(1+sigma)) is verified
# against REPA's own SILoss lognormal weighting rather than guessed.
#
# Requires REPA's source for the model definition (we load through their code
# rather than remapping a state dict -- see teachers._load_sit):
#
#   export REPA_DIR=/root/autodl-tmp/repa-surgery/REPA
#
# and the checkpoint + latents, which live on HuggingFace:
#
#   python3 scripts/fetch_hf.py --repo pakhomovee/imagenet --repo-type dataset \
#       --dest $DD_DATA_ROOT/in100_raw
#
# THAT DOWNLOAD IS >130 GB. Run it only where there is disk for it.

DATASET_NAME="in100_latent"
RESOLUTION=256
LATENT_SIZE=32
NUM_CLASSES=100

DATA_DIR="${DD_DATA_ROOT:-$REPO_ROOT/data}/in100_256"
CKPT_DIR="${DD_CKPT_ROOT:-$REPO_ROOT/ckpt}"

# Point SIT_CKPT at the checkpoint you want to distil from. The default is the
# baseline arm at 300k; the repa/haste arms are equally valid teachers and give
# a second capacity point at identical cost.
SIT_CKPT="${SIT_CKPT:-$CKPT_DIR/imagenet100_sit-b_2_baseline/checkpoints/0300000.pt}"
TEACHER_SPEC="sit:$SIT_CKPT"
TEACHER_NAME=""
TEACHER_CKPT="$SIT_CKPT"

DEFAULT_MICRO_BATCH=64
DEFAULT_STEPS=20000
DEFAULT_GPUS="0,1,2,3"
DEFAULT_N_STUDENT_STEPS=1
DEFAULT_CFG_SCALE=1.5
# SiT trains with t ~ U[0,1] on the linear interpolant, so that -- not EDM's
# lognormal and not a VP timestep grid -- is the matched noise distribution.
DEFAULT_SIGMA_DIST="interp_uniform_t"
DEFAULT_MIN_REAL_BATCH=256

REF_N=25000
REF_NPZ="$DATA_DIR/ref_${RESOLUTION}_${REF_N}.npz"

prepare_dataset() {
  local src="${IN100_SRC:-$REPO_ROOT/data/in100_raw/images}"
  [[ -d "$src" ]] || {
    echo "[$DATASET_NAME] source not found at $src" >&2
    echo "[$DATASET_NAME] fetch it first:" >&2
    echo "  python3 scripts/fetch_hf.py --repo pakhomovee/imagenet \\" >&2
    echo "      --repo-type dataset --dest \$DD_DATA_ROOT/in100_raw" >&2
    echo "[$DATASET_NAME] then set IN100_SRC to the image folder." >&2
    return 1
  }
  # Same SD-VAE and the same 0.18215 scale REPA trained the SiT with
  # (REPA/train.py: latents_scale = 0.18215, latents_bias = 0). Using a
  # different normalisation here would put the teacher off-distribution at every
  # noise level, which validate_teacher would flag as SUSPECT.
  python3 -m ddgpu.prepare latents \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-64}" \
    --num-workers "${ENCODE_NUM_WORKERS:-8}"
  python3 -m ddgpu.prepare refstats \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" --n "$REF_N" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-64}" \
    --num-workers "${ENCODE_NUM_WORKERS:-8}"
}
