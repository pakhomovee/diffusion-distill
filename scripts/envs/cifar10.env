# CIFAR-10 32px, PIXEL space -- the cheap tier's low rung. 3x32x32 = 3072 dims.
#
# Read that dimension against the expensive tier before dismissing this as "just
# CIFAR": DiT-XL/2 on ImageNet-256 works in 4096 latent dims. CIFAR-10 in pixel
# space is 75% of that. The VAE exists to make high RESOLUTION cheap; it does not
# make the working dimension small, and dimension is the axis FINDINGS.md 1.3
# says this method breaks on. See FINDINGS.md 6.
#
# Teacher: google/ddpm-cifar10-32, a released linear-beta eps-predictor. Loads
# through `diffusers` with no friction and no repo to clone. It is
# UNCONDITIONAL, so cfg_scale must be 1.0 -- ddgpu.train raises rather than
# silently ignore a guidance scale an unconditional model cannot use.

DATASET_NAME="cifar10"
RESOLUTION=32
LATENT_SIZE=32
NUM_CLASSES=1

DATA_DIR="${DD_DATA_ROOT:-$REPO_ROOT/data}/cifar10"
CKPT_DIR="${DD_CKPT_ROOT:-$REPO_ROOT/ckpt}"

TEACHER_SPEC="diffusers:google/ddpm-cifar10-32"
TEACHER_NAME=""            # nothing to download by hand; diffusers caches it
TEACHER_CKPT=""

DEFAULT_MICRO_BATCH=128
DEFAULT_STEPS=20000
DEFAULT_GPUS="0"
DEFAULT_N_STUDENT_STEPS=1
DEFAULT_CFG_SCALE=1.0      # unconditional teacher; do not raise this
DEFAULT_SIGMA_DIST="vp_uniform_t"

# FINDINGS.md 1.4's hard floor is 256 real samples for the empirical score. The
# calibration leg sees half of that again (FINDINGS.md 5), so the launcher also
# warns below an effective 512. A single GPU at micro 128 gives 128 and is
# REFUSED -- run CIFAR at --micro-batch 512 on one card (comfortable for a 35M
# UNet at 32px), or across 4 GPUs.
DEFAULT_MIN_REAL_BATCH=256

REF_N=50000
REF_NPZ="$DATA_DIR/ref_${RESOLUTION}_${REF_N}.npz"

prepare_dataset() {
  python3 -m ddgpu.prepare pixels \
    --source cifar10 --dest "$DATA_DIR" --resolution "$RESOLUTION" \
    --batch-size "${ENCODE_BATCH_SIZE:-256}" --num-workers "${ENCODE_NUM_WORKERS:-4}"
  python3 -m ddgpu.prepare refstats \
    --source cifar10 --dest "$DATA_DIR" --resolution "$RESOLUTION" --n "$REF_N" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-256}" \
    --num-workers "${ENCODE_NUM_WORKERS:-4}"
}
