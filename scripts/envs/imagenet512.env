# ImageNet-512 environment: DiT-XL/2 teacher, 4x64x64 latents (16384 dims).
#
# The HIGH rung of the dimension ladder. Identical to imagenet256.env in every
# respect except resolution, which is the point: 4x the latent dimension at
# fixed architecture, parameters and data.
#
# FINDINGS.md 1.3 is the reason this run exists. The synthetic ladder tops out
# at d=512 and a lambda rule that worked to d=128 collapsed at d=512 (3x worse
# than the plain teacher). 16384 is 32x beyond the validated range; if lambda_dsm
# degrades here, Track A does not go to SDXL and the paper's scope contracts.
#
# Note the smaller default micro-batch: activations scale with the token count,
# which is 4x higher here. Watch the Track A effective-real-batch check --
# 16 x 8 GPUs = 128 is BELOW the 256 floor, so this env needs either
# --micro-batch 32 or gradient-free head-room found by `ddgpu.probe`.
#
# Requires ImageNet (ILSVRC2012 train) locally. Point IMAGENET_SRC at the
# class-folder train dir, e.g. .../ILSVRC/Data/CLS-LOC/train (1000 subdirs).

DATASET_NAME="imagenet512"
RESOLUTION=512
LATENT_SIZE=64
NUM_CLASSES=1000

DATA_DIR="${DD_DATA_ROOT:-$REPO_ROOT/data}/in512"
CKPT_DIR="${DD_CKPT_ROOT:-$REPO_ROOT/ckpt}"

# DiT-XL/2 is the ONLY publicly released latent DiT (FINDINGS.md 4.0.1). Running
# the ladder on XL@256 vs XL@512 is cheaper than pretraining a DiT-B/2 teacher
# and is a cleaner ladder besides: identical architecture and data on both rungs.
TEACHER_NAME="DiT-XL-2-512x512"
TEACHER_CKPT="$CKPT_DIR/${TEACHER_NAME}.pt"

DEFAULT_MICRO_BATCH=16
DEFAULT_STEPS=50000
DEFAULT_GPUS="0,1,2,3,4,5,6,7"
DEFAULT_N_STUDENT_STEPS=1
DEFAULT_CFG_SCALE=1.75

# FID / precision-recall reference set.
REF_N=50000
REF_NPZ="$DATA_DIR/ref_${RESOLUTION}_${REF_N}.npz"

prepare_dataset() {
  local src="${IMAGENET_SRC:-$REPO_ROOT/data/imagenet/ILSVRC/Data/CLS-LOC/train}"
  [[ -d "$src" ]] || {
    echo "[$DATASET_NAME] source not found at $src" >&2
    echo "[$DATASET_NAME] set IMAGENET_SRC to your ILSVRC train dir and re-run" >&2
    return 1
  }
  python3 -m ddgpu.prepare latents \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-64}" \
    --num-workers "${ENCODE_NUM_WORKERS:-8}"
  python3 -m ddgpu.prepare refstats \
    --source "$src" --dest "$DATA_DIR" --resolution "$RESOLUTION" --n "$REF_N" \
    --gpus "${GPUS:-0}" --batch-size "${ENCODE_BATCH_SIZE:-64}" \
    --num-workers "${ENCODE_NUM_WORKERS:-8}"
}
